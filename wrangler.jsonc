// Cloudflare Workers config — the site is deployed by "Workers Builds: geoli"
// https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geoli",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": ".",
    // Serve /404.html with a real 404 status for unknown URLs
    "not_found_handling": "404-page",
    // /impressum -> /impressum/ (serves impressum/index.html)
    "html_handling": "auto-trailing-slash"
  }
}
