---
import { getCollection } from 'astro:content';
import { CONFIG } from '../config';
import { useTranslations, localizePath, type Lang } from '../i18n/ui';
import { getPosts, publicFileExists, formatDate } from '../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const hasCv    = publicFileExists(CONFIG.cvPath);
const hasPhoto = publicFileExists(CONFIG.photo);
const hasKey   = /^[0-9a-f-]{36}$/i.test(CONFIG.web3formsKey);

// Latest published posts; announced drafts fill the grid as "Coming soon"
const published = (await getPosts()).slice(0, 3);
const upcoming  = (await getCollection('blog', ({ data }) => data.draft))
  .filter(d => !published.some(p => p.id === d.id))
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf())
  .slice(0, 3 - published.length);

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const blogPath = localizePath('/blog/', lang);
const downloadIcon = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>';
---
<!-- HERO -->
<section class="hero" id="hero" aria-label="Introduction">
  <div class="hero__aurora" aria-hidden="true">
    <div class="aurora aurora--1"></div>
    <div class="aurora aurora--2"></div>
    <div class="aurora aurora--3"></div>
  </div>
  <div class="hero__grid-overlay" aria-hidden="true"></div>
  <div class="hero__content container">
    <div class="hero__badge">
      <span class="badge__dot" aria-hidden="true"></span>
      <span>{t('hero.badge')}</span>
    </div>
    <h1 class="hero__title">
      <span>{t('hero.title1')}</span>
      <span class="gradient-text">{t('hero.title2')}</span>
    </h1>
    <p class="hero__subtitle">{t('hero.subtitle')}</p>
    <div class="hero__cta">
      {CONFIG.bookingUrl
        ? <a href={CONFIG.bookingUrl} class="btn btn--primary" target="_blank" rel="noopener noreferrer">{t('hero.book')}</a>
        : <a href="#services" class="btn btn--primary">{t('hero.cta1')}</a>}
      <a href="#contact" class="btn btn--ghost">{t('hero.cta2')}</a>
      {hasCv && (
        <a href={CONFIG.cvPath} class="btn btn--ghost" download>
          <Fragment set:html={downloadIcon} /><span>{t('about.cv')}</span>
        </a>
      )}
    </div>
    <div class="hero__chips" aria-hidden="true">
      <span class="chip"><span class="chip__icon chip__icon--ai"></span>AI Agents</span>
      <span class="chip"><span class="chip__icon chip__icon--rpa"></span>RPA</span>
      <span class="chip"><span class="chip__icon chip__icon--azure"></span>Azure</span>
    </div>
  </div>
  <a href="#about" class="hero__scroll" aria-label="Scroll to About section">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
  </a>
</section>

<!-- ABOUT -->
<section class="section about" id="about" aria-labelledby="about-title">
  <div class="container">
    <div class="about__grid">
      <div class="about__text reveal">
        <p class="section__label">{t('about.label')}</p>
        <h2 class="section__title" id="about-title">George Lincu</h2>
        <p class="about__lead">{t('about.lead')}</p>
        <p class="about__body">{t('about.body')}</p>
        <div class="about__stats">
          <div class="stat reveal"><span class="stat__number gradient-text">AI</span><span class="stat__label">{t('about.stat1')}</span></div>
          <div class="stat reveal"><span class="stat__number gradient-text">RPA</span><span class="stat__label">{t('about.stat2')}</span></div>
          <div class="stat reveal"><span class="stat__number gradient-text">Azure</span><span class="stat__label">{t('about.stat3')}</span></div>
        </div>
      </div>
      <div class="about__card glass reveal">
        <div class="about__card-glow" aria-hidden="true"></div>
        {hasPhoto
          ? <img class="about__avatar about__avatar--photo" src={CONFIG.photo} alt={CONFIG.name} width="96" height="96" loading="lazy" decoding="async" />
          : <div class="about__avatar" aria-hidden="true">GL</div>}
        <div class="about__info">
          <strong>{CONFIG.name}</strong>
          <span>{t('about.role')}</span>
          <span class="about__company">{CONFIG.company}</span>
        </div>
        <div class="about__tags" aria-label="Skills">
          {['AI Agents', 'RPA', 'Azure', 'Copilot Studio', 'Power Platform', 'Process Mining'].map(s => <span class="tag">{s}</span>)}
        </div>
        {hasCv && (
          <a href={CONFIG.cvPath} class="btn btn--ghost btn--sm" download>
            <Fragment set:html={downloadIcon} /><span>{t('about.cv')}</span>
          </a>
        )}
        <div class="about__status">
          <span class="status__dot" aria-hidden="true"></span>
          <span>{t('about.status')}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- SERVICES -->
<section class="section services" id="services" aria-labelledby="services-title">
  <div class="container">
    <p class="section__label">{t('services.label')}</p>
    <h2 class="section__title" id="services-title">{t('services.title')}</h2>
    <p class="section__subtitle">{t('services.subtitle')}</p>
    <div class="bento">

      <article class="bento__card bento__card--wide glass reveal">
        <div class="bento__glow bento__glow--indigo" aria-hidden="true"></div>
        <div class="bento__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714a2.25 2.25 0 001.5 2.122m-1.5-2.122c.251.023.501.05.75.082M14.25 3.104A24.3 24.3 0 0119 5.5m0 0a2.25 2.25 0 011.5 2.122v.085a2.25 2.25 0 01-1.5 2.122m0-4.329v5.714a2.25 2.25 0 01-.659 1.591L14.5 14.5M5 14.5a2.25 2.25 0 002.25 2.25h9A2.25 2.25 0 0018.5 14.5m-13.5 0v3.75a2.25 2.25 0 002.25 2.25h9a2.25 2.25 0 002.25-2.25V14.5"/></svg>
        </div>
        <div class="bento__body">
          <h3>{t('s1.title')}</h3>
          <p>{t('s1.desc')}</p>
          <ul class="bento__list"><li>{t('s1.l1')}</li><li>{t('s1.l2')}</li><li>{t('s1.l3')}</li></ul>
        </div>
      </article>

      <article class="bento__card glass reveal">
        <div class="bento__glow bento__glow--cyan" aria-hidden="true"></div>
        <div class="bento__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>
        </div>
        <div class="bento__body">
          <h3>{t('s2.title')}</h3>
          <p>{t('s2.desc')}</p>
          <ul class="bento__list"><li>{t('s2.l1')}</li><li>{t('s2.l2')}</li><li>{t('s2.l3')}</li></ul>
        </div>
      </article>

      <article class="bento__card glass reveal">
        <div class="bento__glow bento__glow--purple" aria-hidden="true"></div>
        <div class="bento__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z"/></svg>
        </div>
        <div class="bento__body">
          <h3>{t('s3.title')}</h3>
          <p>{t('s3.desc')}</p>
          <ul class="bento__list"><li>{t('s3.l1')}</li><li>{t('s3.l2')}</li><li>{t('s3.l3')}</li></ul>
        </div>
      </article>

      <article class="bento__card bento__card--wide glass reveal">
        <div class="bento__glow bento__glow--emerald" aria-hidden="true"></div>
        <div class="bento__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z"/></svg>
        </div>
        <div class="bento__body">
          <h3>{t('s4.title')}</h3>
          <p>{t('s4.desc')}</p>
          <ul class="bento__list"><li>{t('s4.l1')}</li><li>{t('s4.l2')}</li><li>{t('s4.l3')}</li></ul>
        </div>
      </article>

    </div>
  </div>
</section>

{projects.length > 0 && (

  <section class="section projects" id="projects" aria-labelledby="projects-title">
    <div class="container">
      <p class="section__label">{t('projects.label')}</p>
      <h2 class="section__title" id="projects-title">{t('projects.title')}</h2>
      <p class="section__subtitle">{t('projects.subtitle')}</p>
      <div class="projects__grid">
        {projects.map(p => (
          <article class="project__card glass reveal">
            <p class="project__client">{p.data.client}</p>
            <h3>{p.data.title}</h3>
            <dl>
              <dt>{t('projects.problem')}</dt><dd>{p.data.problem}</dd>
              <dt>{t('projects.approach')}</dt><dd>{p.data.approach}</dd>
              <dt>{t('projects.outcome')}</dt><dd class="project__outcome">{p.data.outcome}</dd>
            </dl>
            <div class="about__tags">{p.data.tags.map(tag => <span class="tag">{tag}</span>)}</div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<!-- STACK -->
<section class="section stack" id="stack" aria-labelledby="stack-title">
  <div class="container">
    <p class="section__label">{t('stack.label')}</p>
    <h2 class="section__title" id="stack-title">{t('stack.title')}</h2>
    <div class="stack__grid">
      {[
        { h: t('stack.cat1'), items: ['Copilot Studio', 'Azure OpenAI', 'Power Automate', 'UiPath', 'Claude AI', 'LangChain'] },
        { h: t('stack.cat2'), items: ['Microsoft Azure', 'Azure Functions', 'Static Web Apps', 'Cosmos DB', 'Azure DevOps', 'Cloudflare'] },
        { h: t('stack.cat3'), items: ['Power Platform', 'Microsoft 365', 'SharePoint', 'Teams', 'Dataverse', 'GitHub'] },
      ].map(c => (
        <div class="stack__category glass reveal">
          <h3 class="stack__heading">{c.h}</h3>
          <div class="stack__pills">{c.items.map(i => <span>{i}</span>)}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- INSIGHTS / BLOG -->
<section class="section" id="blog" aria-labelledby="blog-title">
  <div class="container">
    <p class="section__label">{t('blog.label')}</p>
    <h2 class="section__title" id="blog-title">{t('blog.title')}</h2>
    <p class="section__subtitle">{t('blog.subtitle')}</p>
    <div class="blog__grid">
      {published.map(post => (
        <article class="blog__card glass reveal">
          <div class="blog__card-top">
            <span class="blog__tag">{post.data.tags[0]}</span>
            <time class="blog__date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
          </div>
          <h3><a href={`/blog/${post.id}/`} class="blog__link" hreflang="en">{post.data.title}</a></h3>
          <p>{post.data.description}</p>
          <span class="blog__read" aria-hidden="true">{t('blog.read')}</span>
        </article>
      ))}
      {upcoming.map(post => (
        <article class="blog__card blog__card--soon glass reveal">
          <div class="blog__card-top"><span class="blog__tag">{post.data.tags[0]}</span></div>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
          <span class="blog__read">{t('blog.soon')}</span>
        </article>
      ))}
    </div>
    {published.length > 0 && <p class="blog__all"><a href={blogPath}>{t('blog.all')}</a></p>}
  </div>
</section>

<!-- CONTACT -->
<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact__inner reveal">
      <div class="contact__glow" aria-hidden="true"></div>
      <p class="section__label">{t('contact.label')}</p>
      <h2 class="section__title" id="contact-title">{t('contact.title')}</h2>
      <p class="contact__subtitle">{t('contact.subtitle')}</p>

      <!-- Contact form — Web3Forms (free). Falls back to mailto: until a key is configured. -->
      <form
        id="contactForm"
        class="contact__form"
        novalidate
        data-configured={hasKey ? 'true' : 'false'}
        data-email={CONFIG.email}
        data-domain={CONFIG.domain}
        data-msg-success={t('form.success')}
        data-msg-error={t('form.error')}
        data-msg-invalid={t('form.invalid')}
        data-msg-sending={t('form.sending')}
      >
        <input type="hidden" name="access_key" value={hasKey ? CONFIG.web3formsKey : ''} />
        <input type="hidden" name="subject"    value={`New message from ${CONFIG.domain}`} />
        <input type="hidden" name="from_name"  value={CONFIG.domain} />
        <input type="checkbox" name="botcheck" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="form__row">
          <div class="form__field">
            <label for="fname">{t('form.name')}</label>
            <input id="fname" type="text" name="name" autocomplete="name" maxlength="120" required />
          </div>
          <div class="form__field">
            <label for="femail">{t('form.email')}</label>
            <input id="femail" type="email" name="email" autocomplete="email" maxlength="200" required />
          </div>
        </div>
        <div class="form__field">
          <label for="fmsg">{t('form.message')}</label>
          <textarea id="fmsg" name="message" rows="5" maxlength="5000" required></textarea>
        </div>
        <button type="submit" class="btn btn--primary form__submit">{t('form.send')}</button>
        <div id="formStatus" class="form__status" hidden role="status" aria-live="polite"></div>
      </form>

      <div class="contact__divider">{t('contact.divider')}</div>

      <div class="contact__links">
        <a href={`mailto:${CONFIG.email}`} class="contact__link glass">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
          <span>{CONFIG.email}</span>
        </a>
        <a href={CONFIG.linkedin} class="contact__link glass" target="_blank" rel="noopener noreferrer me">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          LinkedIn
        </a>
        {CONFIG.bookingUrl && (
          <a href={CONFIG.bookingUrl} class="contact__link glass" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>
            {t('hero.book')}
          </a>
        )}
      </div>
    </div>
  </div>
</section>
