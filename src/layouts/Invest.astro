---
// Private layout for /vault/invest/ — owner-only (the Worker checks before serving these pages).
// No SEO, no JSON-LD, not in the sitemap, noindex. No inline script/style (CSP).
import '../styles/base.css';
import '../styles/invest.css';

interface Props {
  title: string;
  /** Key of the active nav item */
  active: string;
}
const { title, active } = Astro.props;

// Navigation in four groups (now · what I have · plans · analyses). Wide screens: one row with dividers;
// phones: a <details> menu (no JS) with the current page in the summary.
const NAV_GROUPS = [
  { label: 'Acum', items: [
    { key: 'panou',      label: 'Panou',      href: '/vault/invest/' },
  ] },
  { label: 'Ce am', items: [
    { key: 'portofoliu', label: 'Portofoliu', href: '/vault/invest/portofoliu/' },
    { key: 'avere',      label: 'Avere netă', href: '/vault/invest/avere/' },
    { key: 'calendar',   label: 'Calendar',   href: '/vault/invest/calendar/' },
    { key: 'scaderi',    label: 'Scăderi',    href: '/vault/invest/oportunitati/' },
  ] },
  { label: 'Planuri', items: [
    { key: 'plan',       label: 'Plan',       href: '/vault/invest/plan/' },
    { key: 'pensie',     label: 'Pensie',     href: '/vault/invest/pensie/' },
    { key: 'ips',        label: 'IPS',        href: '/vault/invest/ips/' },
    { key: 'jurnal',     label: 'Jurnal',     href: '/vault/invest/jurnal/' },
  ] },
  { label: 'Analize', items: [
    { key: 'rapoarte',   label: 'Rapoarte',   href: '/vault/invest/rapoarte/' },
    { key: 'taxe',       label: 'Taxe',       href: '/vault/invest/taxe/' },
    { key: 'costuri',    label: 'Costuri',    href: '/vault/invest/costuri/' },
    { key: 'simulare',   label: 'Ce-ar fi dacă', href: '/vault/invest/simulare/' },
  ] },
];
const current = NAV_GROUPS.flatMap(g => g.items).find(i => i.key === active);
---
<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="color-scheme" content="dark light" />
  <title>{title} · Investiții · GeoLi</title>
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <!-- Home-screen app: the manifest is behind the owner check (credentials needed); icons are the public site icons.
       No service worker: nothing is stored on the phone, every page comes fresh from the server. -->
  <link rel="manifest" href="/vault/invest/manifest.webmanifest" crossorigin="use-credentials" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
  <meta name="theme-color" content="#08090f" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Investiții" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black" />
  <link rel="preload" href="/assets/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />
  <script is:inline src="/theme-init.js"></script>
</head>
<body class="inv">
  <header class="inv-top">
    <a href="/vault/invest/" class="inv-logo">GeoLi<span>.</span> <small>Investiții</small></a>
    <span class="inv-spacer"></span>
    <a class="inv-btn inv-btn--ghost" href="/vault/">Vault</a>
    <button class="inv-btn inv-btn--ghost" id="themeToggle" type="button" aria-label="Schimbă tema" title="Schimbă tema">Temă</button>
    <a class="inv-btn inv-btn--ghost" href="/cdn-cgi/access/logout">Ieșire</a>
  </header>

  <nav class="inv-nav" aria-label="Secțiuni">
    {NAV_GROUPS.map(g => (
      <div class="inv-nav__group" role="group" aria-label={g.label}>
        {g.items.map(n => <a href={n.href} aria-current={n.key === active ? 'page' : undefined}>{n.label}</a>)}
      </div>
    ))}
  </nav>
  <details class="inv-menu">
    <summary><span class="inv-menu__label">Secțiune:</span> <strong>{current?.label ?? title}</strong></summary>
    <nav class="inv-menu__panel" aria-label="Secțiuni">
      {NAV_GROUPS.map(g => (
        <div class="inv-menu__group">
          <p class="inv-menu__title">{g.label}</p>
          {g.items.map(n => <a href={n.href} aria-current={n.key === active ? 'page' : undefined}>{n.label}</a>)}
        </div>
      ))}
    </nav>
  </details>

  <main class="inv-main" id="main">
    <slot />
  </main>

  <div class="inv-toast" id="toast" role="status" aria-live="polite" hidden></div>

  <script>
    import '../scripts/invest/common';
  </script>
</body>
</html>
