---
import '../styles/base.css';
import '../styles/components.css';
import '../styles/nav.css';
import '../styles/hero.css';
import '../styles/sections.css';
import '../styles/content.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { CONFIG } from '../config';
import { localizePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Does this page exist in both languages? Adds hreflang alternates. */
  translated?: boolean;
  ogImage?: string;
  ogTitle?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  publishedTime?: Date;
  modifiedTime?: Date;
  home?: boolean;
  /** Override <html lang> (e.g. "de" for the Impressum) */
  htmlLang?: string;
  /** Markdown twin of this page for AI agents */
  markdown?: string;
}

const {
  lang, title, description, translated = false, ogImage = '/assets/og-image.png',
  ogTitle = title, type = 'website', noindex = false, jsonLd, publishedTime, modifiedTime, home = false, htmlLang, markdown,
} = Astro.props;

const t         = useTranslations(lang);
const path      = Astro.url.pathname;
const canonical = new URL(path, CONFIG.site).href;
const ogImageUrl = new URL(ogImage, CONFIG.site).href;
const alternates = translated
  ? (['en', 'ro'] as Lang[]).map(l => ({ lang: l, href: new URL(localizePath(path, l), CONFIG.site).href }))
  : [];
---
<!DOCTYPE html>
<html lang={htmlLang ?? lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content={CONFIG.name} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
  <meta name="theme-color" content="#08090f" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#f7f8fc" media="(prefers-color-scheme: light)" />
  <meta name="color-scheme" content="dark light" />
  <link rel="canonical" href={canonical} />
  {alternates.map(a => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
  {translated && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
  <link rel="alternate" type="application/rss+xml" title="GeoLi — Insights" href="/rss.xml" />
  {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
  <link rel="help" type="text/plain" href="/llms.txt" title="Site summary for AI agents" />

  <!-- Open Graph / social cards -->
  <meta property="og:type"         content={type} />
  <meta property="og:site_name"    content="GeoLi" />
  <meta property="og:url"          content={canonical} />
  <meta property="og:title"        content={ogTitle} />
  <meta property="og:description"  content={description} />
  <meta property="og:image"        content={ogImageUrl} />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt"    content={ogTitle} />
  <meta property="og:locale"       content={lang === 'ro' ? 'ro_RO' : 'en_GB'} />
  {translated && <meta property="og:locale:alternate" content={lang === 'ro' ? 'en_GB' : 'ro_RO'} />}
  {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={ogTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImageUrl} />

  <!-- Icons -->
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Self-hosted fonts (no third-party requests) -->
  <link rel="preload" href="/assets/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/syne.woff2"  as="font" type="font/woff2" crossorigin />

  <script is:inline src="/theme-init.js"></script>
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <a href="#main" class="visually-hidden skip-link">{t('a11y.skip')}</a>
  <div class="noise" aria-hidden="true"></div>

  <Nav lang={lang} home={home} translated={translated} />

  <main id="main">
    <slot />
  </main>

  <Footer lang={lang} />

  <script>
    import '../scripts/site';
  </script>
</body>
</html>
